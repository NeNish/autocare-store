NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/autocare-store
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional: enables the AI windshield care assistant (Claude). Without it, the
# assistant answers from its built-in care guide.
ANTHROPIC_API_KEY=
# Optional: Claude model for the assistant
ASSISTANT_MODEL=claude-haiku-5-5

# Shop name shown in the Razorpay payment window
STORE_NAME=AutoCare

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret for https://<api>/api/payments/razorpay/webhook
# (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid order holds its stock
PAYMENT_WINDOW_MIN=30

# Daily job (Vercel Cron sends this automatically as a Bearer token)
CRON_SECRET=

# Optional: send blade replacement reminder emails through Resend
RESEND_API_KEY=
EMAIL_FROM=AutoCare <reminders@yourdomain.in>
